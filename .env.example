# =============================================================================
# Academy Scheduling App — Environment Variables
#
# LOCAL DEV:
#   1. Copy this file to `.env.local`  ->  cp .env.example .env.local
#   2. Fill in the values from Supabase Dashboard -> Project Settings -> API.
#   3. `.env.local` is gitignored and is loaded automatically by `next dev`.
#
# VERCEL:
#   Add each variable below under Project -> Settings -> Environment Variables
#   for the Production, Preview, and Development environments.
#   NEXT_PUBLIC_* values are exposed to the browser (safe: protected by RLS).
#   Non-prefixed values are server-only secrets and must never be exposed.
# =============================================================================

# --- Client-side (safe to expose; protected by Row Level Security) ----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Server-only secrets (NEVER commit, NEVER prefix with NEXT_PUBLIC_) ------
# Used for admin/server actions and for applying migrations programmatically.
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
# SUPABASE_DB_URL=postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres

# --- Data & Reports Pilot (server-only) -------------------------------------
# Microsoft Teams Incoming Webhook or Power Automate URL for weekly summaries.
# TEAMS_REPORTS_WEBHOOK_URL=https://outlook.office.com/webhook/...
# Bearer token for Vercel Cron → /api/cron/reports and /api/cron/availability
# CRON_SECRET=your-random-secret

# --- Availability collection (server-only) ------------------------------------
# Public base URL for magic links (production domain)
# NEXT_PUBLIC_APP_URL=https://tennis-schedule.vercel.app

# Microsoft Graph — send availability emails (application permissions: Mail.Send)
# MS_GRAPH_TENANT_ID=your-tenant-id
# MS_GRAPH_CLIENT_ID=your-app-client-id
# MS_GRAPH_CLIENT_SECRET=your-client-secret
# MS_GRAPH_SENDER=tennis-ops@imgacademy.com

# Twilio — send availability SMS
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM_NUMBER=+15551234567
