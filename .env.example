# =============================================================================
# Academy Scheduling App — Environment Variables
#
# LOCAL DEV:
#   1. Copy this file to `.env.local`  ->  cp .env.example .env.local
#   2. Fill in the values from Supabase Dashboard -> Project Settings -> API.
#   3. `.env.local` is gitignored and is loaded automatically by `next dev`.
#
# VERCEL:
#   Add each variable below under Project -> Settings -> Environment Variables
#   for the Production, Preview, and Development environments.
#   NEXT_PUBLIC_* values are exposed to the browser (safe: protected by RLS).
#   Non-prefixed values are server-only secrets and must never be exposed.
# =============================================================================

# --- Client-side (safe to expose; protected by Row Level Security) ----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Server-only secrets (NEVER commit, NEVER prefix with NEXT_PUBLIC_) ------
# Used for admin/server actions and for applying migrations programmatically.
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
# SUPABASE_DB_URL=postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres
